# Copy this file to .env. Keep credentials only in this backend folder.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Only for temporary credentials (e.g. a classroom AWS sandbox):
AWS_SESSION_TOKEN=
# Optional: use an existing AWS profile/role instead of the keys above.
USE_AWS_DEFAULT_CREDENTIALS=false
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
